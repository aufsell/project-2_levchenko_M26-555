[0.001, "o", "\u001b]2;database\u0007\u001b]1;database\u0007"]
[0.037, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.000, "o", "Введите команду: "]
[7.881, "o", "create_table demo_users name:str age:int"]
[0.600, "o", "\r\n"]
[0.002, "o", "Таблица \"demo_users\" успешно создана со столбцами: ID:int, name:str, age:int\r\n"]
[0.000, "o", "Введите команду: "]
[5.650, "o", "list_tables"]
[0.301, "o", "\r\n"]
[0.000, "o", "- demo_users\r\n"]
[0.000, "o", "Введите команду: "]
[4.533, "o", "create_table demo_users name:str"]
[0.056, "o", "v"]
[0.917, "o", "\b \b"]
[0.728, "o", "\r\n"]
[0.001, "o", "Таблица с таким именем уже существует\r\n"]
[0.000, "o", "Введите команду: "]
[4.280, "o", "drop_table demo_users"]
[0.202, "o", "\r\n"]
[0.001, "o", "Таблица \"demo_users\" успешно удалена\r\n"]
[0.000, "o", "Введите команду: "]
[3.848, "o", "list_tables"]
[0.305, "o", "\r\n"]
[0.000, "o", "Таблиц пока нет.\r\n"]
[0.000, "o", "Введите команду: "]
